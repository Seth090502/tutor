  {
    "name": "workspace",
    "description": "Keep a working set of documents so later grep and citations calls can be scoped to it. Actions: add, remove, list, clear. Takes doc_ids; a named workspace is optional and defaults to your session's. Adding a document that is already present, or removing one that is absent, changes nothing. While workspaces are not built this tool answers not_yet_available.",
    "inputSchema": {
      "$defs": {
        "WorkspaceAction": {
          "enum": [
            "add",
            "remove",
            "list",
            "clear"
          ],
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "action": {
          "$ref": "#/$defs/WorkspaceAction"
        },
        "doc_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace": {
          "default": null,
          "description": "Named workspace; defaults to the caller's session workspace.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "grep",
    "description": "Exact or regular-expression search over canonical text (Rust regex syntax; plain text is a valid pattern). Scope is a list of documents, the workspace, a category (with optional area), or the whole vault. Every hit carries its exact address and line, with context_lines of surrounding text; use read for more. Several patterns can run in one call; each hit says which pattern matched. Prefer grep when you know the words.",
    "inputSchema": {
      "$defs": {
        "Scope": {
          "oneOf": [
            {
              "properties": {
                "doc_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "kind": {
                  "const": "docs",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "doc_ids"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "workspace",
                  "type": "string"
                },
                "workspace": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            },
            {
              "properties": {
                "area": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "category": {
                  "type": "string"
                },
                "kind": {
                  "const": "category",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "category"
              ],
              "type": "object"
            },
            {
              "properties": {
                "kind": {
                  "const": "vault",
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "case_insensitive": {
          "default": false,
          "type": "boolean"
        },
        "context_lines": {
          "default": 0,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_hits": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tokens": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "patterns": {
          "description": "Regular expressions (Rust `regex` syntax). Plain text is a valid pattern.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        }
      },
      "required": [
        "patterns",
        "scope"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "read",
    "description": "Read exact text at addresses (doc_id#L120-L148, or a single line doc_id#L7). The text is returned verbatim from the canonical store with its printed page and section. expand widens each address: lines (before and after counts of extra lines) or section (the whole innermost heading section). Pass many addresses at once. Unknown ids and out-of-range lines are reported per address without failing the others. A superseded document still reads exactly as cited and names its newer version.",
    "inputSchema": {
      "$defs": {
        "Expand": {
          "oneOf": [
            {
              "description": "Add lines before and after each address.",
              "properties": {
                "after": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "before": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                },
                "mode": {
                  "const": "lines",
                  "type": "string"
                }
              },
              "required": [
                "mode",
                "before",
                "after"
              ],
              "type": "object"
            },
            {
              "description": "Widen each address to the innermost heading section containing it.",
              "properties": {
                "mode": {
                  "const": "section",
                  "type": "string"
                }
              },
              "required": [
                "mode"
              ],
              "type": "object"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "addresses": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expand": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expand"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_tokens": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "addresses"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "outline",
    "description": "Show a document's structure: the heading tree with line ranges and printed pages (for a repository, the file tree), and for source files their symbols. Use it to choose which lines to read. Pass several doc_ids at once; max_depth limits heading depth.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "doc_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_depth": {
          "default": null,
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tokens": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "doc_ids"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "citations",
    "description": "Follow citations within the vault: what the given documents cite (direction cites), what cites them (cited_by), or both. Each edge shows the reference as written, its address in the citing document, and the cited document when it is in the vault or an external id when it is not. While citation data is not built this tool answers not_yet_available.",
    "inputSchema": {
      "$defs": {
        "Direction": {
          "oneOf": [
            {
              "enum": [
                "both"
              ],
              "type": "string"
            },
            {
              "const": "cites",
              "description": "What these documents cite (papers: reference lists; code: what it imports or calls).",
              "type": "string"
            },
            {
              "const": "cited_by",
              "description": "What cites these documents (papers: citing documents; code: what uses it).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "doc_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "k": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tokens": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "doc_ids",
        "direction"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
