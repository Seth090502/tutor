[
  {
    "name": "search",
    "description": "Find passages by meaning and keywords. Pass 2-4 focused queries in one call and narrow the shelf with filters (category, area, kind, level, year range, language, openalex_topic, batch, repo). Each hit is exact text with its address, printed page label and section path, plus a summary of its document. While the retrieval index is not built this tool answers not_yet_available: use find_docs, grep and read meanwhile.",
    "inputSchema": {
      "$defs": {
        "DocKind": {
          "enum": [
            "paper",
            "book",
            "chapter",
            "thesis",
            "report",
            "notes",
            "code",
            "repository",
            "other"
          ],
          "type": "string"
        },
        "Filters": {
          "description": "Filters shared by search, find_docs, grep (category scope) and define. Every field is optional.",
          "properties": {
            "area": {
              "default": null,
              "description": "Psychology study-map area (`memory`, `clinical`, ...); requires category `psych-cogsci` or none.",
              "type": [
                "string",
                "null"
              ]
            },
            "batch": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "category": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DocKind"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "language": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "level": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "openalex_topic": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "repo": {
              "default": null,
              "description": "Restrict to documents of one source-code repository.",
              "type": [
                "string",
                "null"
              ]
            },
            "year_from": {
              "default": null,
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "year_to": {
              "default": null,
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "filters": {
          "$ref": "#/$defs/Filters",
          "default": {
            "area": null,
            "batch": null,
            "category": null,
            "kind": null,
            "language": null,
            "level": null,
            "openalex_topic": null,
            "repo": null,
            "year_from": null,
            "year_to": null
          }
        },
        "k": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tokens": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "queries": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "queries"
      ],
      "type": "object"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
